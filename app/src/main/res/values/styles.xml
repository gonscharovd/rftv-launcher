<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark, TV-readable dialog theme with the same restrained glass surface as RFTV panels. -->
    <style name="RftvDialogTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/rftv_dialog_glass</item>
        <item name="android:windowDimAmount">0.52</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:colorAccent">#FFFFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#CCFFFFFF</item>
        <item name="android:windowMinWidthMajor">58%</item>
        <item name="android:windowMinWidthMinor">78%</item>
    </style>
</resources>
