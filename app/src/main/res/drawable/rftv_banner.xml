<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#071426"
                android:centerColor="#102B4A"
                android:endColor="#07101F"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="190dp"
        android:height="190dp"
        android:gravity="right|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#263F78" />
        </shape>
    </item>
    <item
        android:width="132dp"
        android:height="132dp"
        android:gravity="right|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#315E9B" />
        </shape>
    </item>
    <item
        android:width="82dp"
        android:height="82dp"
        android:gravity="right|center_vertical">
        <shape android:shape="oval">
            <solid android:color="#5B8FC5" />
        </shape>
    </item>
    <item
        android:left="18dp"
        android:top="18dp"
        android:right="18dp"
        android:bottom="18dp">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <stroke
                android:width="1dp"
                android:color="#40FFFFFF" />
            <solid android:color="#12FFFFFF" />
        </shape>
    </item>
</layer-list>
