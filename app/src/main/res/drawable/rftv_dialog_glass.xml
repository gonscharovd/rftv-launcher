<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/rftv_dialog_gradient_start"
                android:centerColor="@color/rftv_dialog_gradient_middle"
                android:endColor="@color/rftv_dialog_gradient_end" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/rftv_dialog_stroke" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="@color/rftv_dialog_highlight_top"
                android:centerColor="@color/rftv_dialog_highlight_middle"
                android:endColor="@color/rftv_dialog_highlight_bottom" />
            <corners android:radius="23dp" />
        </shape>
    </item>
</layer-list>
